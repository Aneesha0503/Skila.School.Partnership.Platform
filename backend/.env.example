# Mistral AI Scraper & Email Generation
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=ministral-14b-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ==============================================================================
# EMAIL DISPATCH CONFIGURATION (Optional - for 1-Click Automated Sending)
# Note: You can always use the "Open in Mail Client" button with ZERO credentials!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COMPANY ACCOUNT (e.g. Google Workspace, SendGrid, Resend, or Zoho)
# ------------------------------------------------------------------------------
COMPANY_EMAIL_NAME="Skila AI Partnerships"
COMPANY_EMAIL_ADDRESS="partnerships@skila.ai"
COMPANY_SMTP_HOST=smtp.gmail.com
COMPANY_SMTP_PORT=587
COMPANY_SMTP_USER="partnerships@skila.ai"
COMPANY_SMTP_PASSWORD="your_16_char_google_app_password"

# ------------------------------------------------------------------------------
# 2. PERSONAL ACCOUNT (e.g. Personal Gmail)
# ------------------------------------------------------------------------------
PERSONAL_EMAIL_NAME="Your Name"
PERSONAL_EMAIL_ADDRESS="yourname@gmail.com"
PERSONAL_SMTP_HOST=smtp.gmail.com
PERSONAL_SMTP_PORT=587
PERSONAL_SMTP_USER="yourname@gmail.com"
# To get a 16-character App Password for personal Gmail:
# 1. Visit: https://myaccount.google.com/apppasswords
# 2. Name it "Skila School Platform"
# 3. Paste the generated 16-character code below (no spaces):
PERSONAL_SMTP_PASSWORD="your_personal_gmail_app_password"
